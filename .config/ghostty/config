font-family = "CommitMono Nerd Font"

# Disables ligatures
font-feature = "-calt"
font-feature = "-liga"
font-feature = "-dlig"

theme = "light:Iceberg Light,dark:Iceberg Dark"

shell-integration-features = "no-cursor"
cursor-style = "block"
cursor-style-blink = "false"

window-padding-x = 0
window-padding-y = 0
